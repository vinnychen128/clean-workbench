# 清洗项目 —— 本地配置样例（AI 辅助层）
#
# 用法：复制为仓库根 `.env` 后按需填写（`cp .env.example .env`），文件权限建议 0600。
# 纪律：`.env` 不入仓（已在 .gitignore）；本文件只放键名与默认值，**任何真实密钥不得写入本文件**。
#
# 数据边界：AI 辅助层**默认关闭**；开启后默认只发送「列的形态标签 + 列级统计」，不发送原始数据值。
#          数据不出本地，是否开启由你决定。

# ── AI 辅助层（默认全部关闭 / 留空）────────────────────────────────
# 总开关，默认关。不配置 = 保持默认环境下的原有行为（13 个既有端点与界面零变化）
CLEAN_AI_ENABLED=false

# provider：none（不启用） / openai_compatible（本地端点或云 API，同一套代码路径，切换只改配置）
CLEAN_AI_PROVIDER=none

# OpenAI 兼容端点地址。本地示例：http://127.0.0.1:11434/v1 ；云 API 示例：https://api.example.com/v1
CLEAN_AI_BASE_URL=

# 模型名，如 qwen2.5:14b
CLEAN_AI_MODEL=

# 密钥：**只从环境变量或本文件读取**，不落日志 / 不落台账 / 不回显 / 不入仓。
# 本地模型（Ollama 类）无需密钥，可留空 —— 这是最简路径。
CLEAN_AI_API_KEY=

# 单次调用超时（秒）
CLEAN_AI_TIMEOUT_S=20

# 每列采样值个数（形态化前；shape_only 模式下只发送这些值的**形态标签**）
CLEAN_AI_MAX_SAMPLE=5

# 数据共享级别：shape_only（默认，只发形态标签） / redacted_samples（额外发送脱敏采样值，默认关）
CLEAN_AI_VALUE_SHARING=shape_only

# 列名共享方式：on（列名命中敏感词表时替换为「列#n」） / masked（一律替换为「列#n」）
CLEAN_AI_COLUMN_NAME_SHARING=on

# 本地缓存开关（缓存键含 provider|model|prompt_version|用途|输入摘要，命中即复用不重复外呼）
CLEAN_AI_CACHE=true
